  "versions": {
    "strict": "Strict person: rows sharing identical normalized last/first/middle name + site + street + city + state + ZIP + country (exact-duplicate rows collapsed first). Conservative: one human at two address spellings counts twice.",
    "merged": "Merged person: strict persons unioned within a (name, country) block when sharing a site or city+state. Catches multi-site investigators; cross-state movers stay split; blank/NG names never merged.",
    "raw": "Raw bound: person keyed by FDA Reviewer ID (INVN) on un-deduplicated rows (naive ID counting). INVN is one-per-site-record, so this overcounts humans and bounds the assumption effect from above."
  },
  "definitions": {
    "person_strict": "Strict person: rows sharing identical normalized last/first/middle name + site + street + city + state + ZIP + country (exact-duplicate rows collapsed first). Conservative: one human at two address spellings counts twice.",
    "person_merged": "Merged person: strict persons unioned within a (name, country) block when sharing a site or city+state. Catches multi-site investigators; cross-state movers stay split; blank/NG names never merged.",
    "person_raw": "Raw bound: person keyed by FDA Reviewer ID (INVN) on un-deduplicated rows (naive ID counting). INVN is one-per-site-record, so this overcounts humans and bounds the assumption effect from above.",
    "trials_per_person": "Trials per person: collapsed BMIS rows per person-cluster. One row = one IND submission reference, a proxy for trials, not confirmed distinct trials.",
    "active": "Active in year: person has >=1 BMIS receipt in that calendar year. New: first receipt ever falls in that year (2008-09 inflated: file starts Oct 2008). Returning: active and first seen earlier.",
    "one_trial": "One-trial (one-and-done): person-cluster linked to exactly one IND reference across the full 1980-2026 file span.",
    "scope_unadjusted": "Unadjusted benchmark: all TYPE=CI BMIS persons vs. all global industry-led interventional trial starts (clinicaltrials.gov).",
    "scope_adjusted": "Adjusted benchmark: US-band BMIS persons vs. industry-led interventional trials with >=1 US site.",
    "starts_running": "Starts: trials by Study Start Date year. Running: start <= year-end AND (completion >= year-start OR still active with no completion date). CT.gov snapshot date recorded in manifest.",
    "tightness": "Tightness ratio: active investigators per running trial. Descriptive workload proxy only; supply and trial counts are not independent (a supply crunch can suppress starts), so this is not causal.",
    "partial": "2008 (file ramp-up from Oct 1) and 2026 (file through Aug 31) are partial: shown faded, excluded from growth statistics.",
    "bmis_scope": "BMIS covers CDER IND drug/biologic investigators whose 1572/1571 was forwarded to FDA since Oct 2008. FDA: not a comprehensive list (1572 goes to the sponsor; forwarding is voluntary-ish). No devices, no CBER, no non-IND research.",
    "cro": "CRO views group BMIS TYPE=CRO rows by normalized company name: evidence-based aliases for known giants (PPD, Medpace, IQVIA, PRA, Syneos, ICON, Parexel, Covance, Celerion, others), else first site segment with suffixes/punctuation stripped. Same-name companies materially spanning states are state-qualified; aliases stay global. Residual variants stay split; cro_index lists variants.",
    "trials_per_year": "Trials/year rate: lifetime IND references divided by the inclusive first-to-last receipt span in calendar years. Intensity measure, not a headcount; single-year bursts rank high by construction.",
    "irb": "IRB views group BMIS TYPE=IRB rows by normalized board name: evidence-based aliases for known boards (Advarra, WCG/Western, Copernicus, IntegReview, Schulman, Quorum, Sterling, Chesapeake), else first non-empty site segment with IRB stopwords, room markers, and numbers stripped. Same-name boards materially spanning states are state-qualified; aliases stay global. Residual variants stay split; irb_index lists variants.",
    "retention": "Cohort retention: share of a first-seen cohort active again k years later. Right-censored (recent cohorts show fewer years); 2008-09 cohorts' first-seen year is inflated by the file start.",
    "concentration": "Annual concentration: share of each year's receipts going to the year's top 1%/10% investigators by receipts, plus the Gini of per-investigator yearly receipts. Higher means work concentrated in fewer hands."
  },
